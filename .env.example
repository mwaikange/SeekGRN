SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@paysme.site
SMTP_PASS=
SMTP_FROM=SeekGRNJobs <support@paysme.site>

# Vercel server-only subscription/payment variables (never prefix these with VITE_).
# Copy Merchant ID UUID and integration API key from the SeekGRNJobs merchant snippet.
PAYSME_MERCHANT_ID=
PAYSME_API_KEY=
PAYSME_WEBHOOK_SECRET=
