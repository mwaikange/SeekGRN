# Optional overrides. The defaults point to the SeekGRnJobs Supabase project.
VITE_SUPABASE_URL=https://dmrtrkhjlarjzhaxyflf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel server-only variables for account-removal email delivery.
# Use the settings supplied by your email host. Never prefix these with VITE_.
